# Multi-scene research: publish curated outputs, not runtime state or model caches.
/research/active_operation.txt
/research/runs/
/research/models/
/research/dataset*.json
/research/training_data/
/research/release_assets/
/research/paper/*.aux
/research/paper/*.log
/research/paper/*.out
/research/paper/*.toc

# Research model tensors stay local; retain code, configuration and JSON histories.
/research/**/*.pt
/research/**/*.pth
/research/**/*.bin
/research/**/*.safetensors
/research/**/*.ckpt
/research/**/*.onnx

# Course delivery: large review media distributed as release assets.
/research/course_delivery/presentation/*.pptx
/research/course_delivery/presentation/*.mp4
/research/course_delivery/delivery/
/research/course_delivery/**/*.aux
/research/course_delivery/**/*.out
/research/course_delivery/**/*.toc
/research/course_delivery/**/*.synctex.gz

